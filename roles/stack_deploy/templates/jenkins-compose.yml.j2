services:
  jenkins:
    image: jenkins/jenkins:{{ jenkins_version }}
    user: root
    environment:
      JAVA_OPTS: "-Djenkins.install.runSetupWizard=false"
    volumes:
      - jenkins_local_data:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - jenkins_net
    restart: always

  oauth2-proxy-jenkins:
    image: quay.io/oauth2-proxy/oauth2-proxy:{{ oauth2_proxy_version }}
    command: --http-address=0.0.0.0:4181 --upstream=http://jenkins:8080
    environment:
      OAUTH2_PROXY_PROVIDER: keycloak-oidc
      OAUTH2_PROXY_CLIENT_ID: {{ jenkins_client_id }}
      OAUTH2_PROXY_CLIENT_SECRET: {{ jenkins_client_secret }}
      OAUTH2_PROXY_COOKIE_SECRET: {{ jenkins_cookie_secret }}
      OAUTH2_PROXY_CODE_CHALLENGE_METHOD: "S256"
      OAUTH2_PROXY_OIDC_ISSUER_URL: https://{{ auth_url }}/realms/{{ keycloak_realm }} 
      OAUTH2_PROXY_EMAIL_DOMAINS: "*"
      OAUTH2_PROXY_REDIRECT_URL: https://{{ jenkins_url }}/oauth2/callback
      OAUTH2_PROXY_REVERSE_PROXY: "true"
      OAUTH2_PROXY_COOKIE_SECURE: "true"
      OAUTH2_PROXY_COOKIE_SAMESITE: "lax"
      OAUTH2_PROXY_COOKIE_DOMAINS: ".{{ domain_base }}"
      OAUTH2_PROXY_COOKIE_EXPIRE: "1h"
      OAUTH2_PROXY_COOKIE_REFRESH: "15m"
      OAUTH2_PROXY_SSL_INSECURE_SKIP_VERIFY: "true" 
      OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL: "true"
    networks:
      - jenkins_net
    extra_hosts:
      - "{{ auth_url }}:host-gateway"
      - "{{ jenkins_url }}:host-gateway"
    restart: always
    ports:
      - "127.0.0.1:4181:4181" # Exposed to Host for Nginx Proxy

volumes:
  jenkins_local_data:

networks:
  jenkins_net:
    driver: bridge
