# Nginx Configuration with Centralized Forward Auth

server {
    listen 80;
    server_name {{ auth_url }};

    location / {
        # Directly proxy to IAM Identity Provider
        proxy_pass http://{{ keycloak_backend_ip }}:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name {{ pma_url }};

    # Large buffers for OIDC headers
    large_client_header_buffers 4 32k;

    location /oauth2/ {
        # Route OAuth2 endpoints directly to the OAuth2-Proxy
        proxy_pass http://{{ oauth2proxy_backend_ip }}:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
    }

    location = /oauth2/auth {
        # Internal endpoint for auth_request subrequests
        internal;
        proxy_pass http://{{ oauth2proxy_backend_ip }}:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        # Drop the request body for the subrequest
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    location / {
        # Centralized Forward Auth Check
        auth_request /oauth2/auth;
        
        # If the auth_request returns a 401, redirect to sign_in
        error_page 401 = /oauth2/sign_in;

        # Pass authenticated user details to backend
        auth_request_set $user $upstream_http_x_auth_request_user;
        auth_request_set $email $upstream_http_x_auth_request_email;
        proxy_set_header X-User $user;
        proxy_set_header X-Email $email;

        # Forward traffic to phpMyAdmin app tier
        proxy_pass http://{{ pma_backend_ip }}:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
