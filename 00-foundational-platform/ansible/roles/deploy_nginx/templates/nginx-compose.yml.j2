services:
  nginx:
    image: nginx:latest
    ports:
      - "0.0.0.0:80:80"
      - "0.0.0.0:443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      # In a real environment, you'd mount certificates here too
      #- /etc/nginx/certs:/etc/nginx/certs:ro
    restart: always
